@using GameTracker.ViewModels
@using GameTracker.Data.Models;
@model GameSaveViewModel
@{
    ViewData["Title"] = "Edit Saved Game";
}

<h3 class="mb-4">Edit Save</h3>

<div class="col-md-6">
    <form asp-controller="Game" asp-action="EditSavedGame" method="post">
        <input hidden asp-for="@Model.Id" value="@Model.Id" />
        <input hidden asp-for="@Model.Title" value="@Model.Title"/>
        <h4>@Model.Title</h4>
        <div class="form-group mt-2">
            <label asp-for="@Model.Status" class="form-label"></label>
            <select asp-for="@Model.Status" class="form-control" asp-items="Html.GetEnumSelectList<GameStatus>()"></select>
        </div>
        <div class="form-group mt-2">
            <label asp-for="@Model.Rating" class="form-label"></label>
            <input asp-for="@Model.Rating" class="form-control" value="@Model.Rating" max="10" min="0"/>
        </div>

        <div class="d-flex justify-content-end mt-3">
            <button class="btn btn-primary" type="submit">Save</button>
        </div>
    </form>
</div>