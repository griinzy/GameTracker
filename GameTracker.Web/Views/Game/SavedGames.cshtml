@using GameTracker.ViewModels
@model IEnumerable<GameSaveViewModel>
@{
    ViewData["Title"] = "Saved Games";
}

<div>
    <table class="table">
        <thead>
            <tr>
                <th>Title</th>
                <th>Status</th>
                <th>Rating</th>
                <th>Added On</th>
                <th></th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var game in Model)
            {
                <tr>
                    <td>@game.Title</td>
                    <td>@game.Status</td>
                    <td>@game.Rating</td>
                    <td>@game.AddedOn</td>
                    <td><a asp-controller="Game" asp-action="EditSavedGame" asp-route-id="@game.Id">Edit</a></td>
                    <td><a asp-controller="Game" asp-action="DeleteSavedGame" asp-route-id="@game.Id">Remove</a></td>
                </tr>
            }
        </tbody>
    </table>
</div>