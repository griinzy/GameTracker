@using GameTracker.ViewModels
@model PaginatedGamesViewModel
@{
    ViewData["Title"] = "Games";
}

@if (User.Identity.IsAuthenticated)
{   
    <div class="d-flex justify-content-end gap-2">
        <a class="btn btn-primary" asp-controller="Game" asp-action="Create">Add Game</a>
        @if (User.IsInRole("Admin"))
        {
            <a class="btn btn-outline-primary" asp-controller="Admin" asp-action="CreateGenre">Add Genre</a>
            <a class="btn btn-outline-primary" asp-controller="Admin" asp-action="CreateDeveloper">Add Developer</a>
        }
    </div>
    <hr />
}

<form asp-action="Index" method="get">
    <select name="sortBy" class="form-select" onchange="this.form.submit()">
        <option value="" selected disabled>Sort</option>
        <option value="title">Title</option>
        <option value="genre">Genre</option>
        <option value="developer">Developer</option>
    </select>
</form>

<div>
    <table class="table">
        <thead>
            <tr>
                <th></th>
                <th>Title</th>
                <th>Description</th>
                <th>Genre</th>
                <th>Developer</th>
                <th></th>
                @if (User.Identity.IsAuthenticated)
                {
                    <th></th>
                    <th></th>
                    <th></th>
                }
            </tr>
        </thead>
        <tbody>
            @foreach(var game in Model.Games)
            {
                <tr class="align-middle">
                    <td class="p-1"><img src="@game.ImageUrl" style="max-height: 50px"/></td>
                    <td>@game.Title</td>
                    <td title="@game.Description" class="description">@game.Description</td>
                    <td>@game.Genre</td>
                    <td>@game.Developer</td>
                    <td><a asp-controller="Game" asp-action="Details" asp-route-id="@game.Id" class="btn btn-link">Details</a></td>
                    @if (User.Identity.IsAuthenticated)
                    {   
                        <td>
                            <form asp-controller="Library" asp-action="Save" method="post">
                                <input type="hidden" name="id" value="@game.Id" />
                                <button type="submit" class="btn btn-link">Save</button>
                            </form>
                        </td>
                        @if(User.IsInRole("Admin"))
                        {
                            <td><a asp-controller="Admin" asp-action="Edit" asp-route-id="@game.Id" class="btn btn-link">Edit</a></td>
                            <td><a asp-controller="Admin" asp-action="Delete" asp-route-id="@game.Id" class="btn btn-link">Delete</a></td>
                        }
                    }
                </tr>
            }
        </tbody>
</table>
    <div class="d-flex justify-content-between mt-3">
        <a asp-action="Index" asp-route-page="@(Model.CurrentPage - 1)" class="btn btn-outline-secondary @(Model.CurrentPage <= 1 ? "disabled" : "")">Previous</a>
        <a asp-action="Index" asp-route-page="@(Model.CurrentPage + 1)" class="btn btn-outline-secondary @(Model.CurrentPage >= Model.TotalPages ? "disabled" : "")">Next</a>
    </div>
</div>