@using GameTracker.ViewModels
@model IEnumerable<GameIndexViewModel>
@{
    ViewData["Title"] = "Games";
}

@if (User.Identity.IsAuthenticated)
{   
<div class="d-flex justify-content-end gap-2">
    <a class="btn btn-primary" asp-controller="Game" asp-action="Create">Add Game</a>
    <a class="btn btn-outline-primary" asp-controller="Game" asp-action="CreateGenre">Add Genre</a>
    <a class="btn btn-outline-primary" asp-controller="Game" asp-action="CreateDeveloper">Add Developer</a>
</div>
<hr />
}
<div>
    <table class="table">
        <thead>
            <tr>
                <th></th>
                <th>Title</th>
                <th>Description</th>
                <th>Genre</th>
                <th>Developer</th>
                <th></th>
                @if (User.Identity.IsAuthenticated)
                {
                <th></th>
                <th></th>
                <th></th>
                }
            </tr>
        </thead>
        <tbody>
            @foreach(var game in Model)
            {
                <tr class="align-middle">
                    <td class="p-1"><img src="@game.ImageUrl"/></td>
                    <td>@game.Title</td>
                    <td title="@game.Description">
                        @(
                                game.Description != null && game.Description.Length > 60
                                ? game.Description.Substring(0, 60) + "..."
                                : game.Description
                                )
                    </td>
                    <td>@game.Genre</td>
                    <td>@game.Developer</td>
                    <td><a asp-controller="Game" asp-action="Details" asp-route-id="@game.Id" class="btn btn-link">Details</a></td>
                    @if (User.Identity.IsAuthenticated)
                    {   
                    <td>
                        <form asp-controller="Game" asp-action="Save" method="post">
                            <input type="hidden" name="id" value="@game.Id" />
                            <button type="submit" class="btn btn-link">Save</button>
                        </form>
                    </td>
                    <td><a asp-controller="Game" asp-action="Edit" asp-route-id="@game.Id" class="btn btn-link">Edit</a></td>
                    <td><a asp-controller="Game" asp-action="Delete" asp-route-id="@game.Id" class="btn btn-link">Delete</a></td>
                    }
                </tr>
            }
        </tbody>
</table>
</div>