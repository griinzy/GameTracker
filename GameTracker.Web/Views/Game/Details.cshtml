@using GameTracker.ViewModels
@model GameDetailsViewModel

<h3 class="mb-4">Game Details</h3>

<div class="col-md-6">
    <form>
        <div class="form-group mt-2">
            <label class="form-label">Title</label>
            <input class="form-control" disabled value="@Model.Title"/>
        </div>
        <div class="form-group mt-2">
            <label class="form-label">Description</label>
            <textarea class="form-control" rows="4" disabled>@Model.Description</textarea>
        </div>
        <div class="form-group mt-2">
            <label class="form-label">Genre</label>
            <input class="form-control" disabled value="@Model.Genre"/>
        </div>
        <div class="form-group mt-2">
            <label class="form-label">Developer</label>
            <input class="form-control" disabled value="@Model.Developer"/>
        </div>
    </form>
</div>